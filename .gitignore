# Dependencies
node_modules/

# Build output
dist/
build/
storybook-static/
*.tsbuildinfo

# Generated by the components build (cem analyze)
packages/components/custom-elements.json

# Tool caches
.turbo/
.angular/
.vite/
.cache/
coverage/

# Reports written by tools/ are attached to PRs, not committed
reports/

# Self-hosted CDN tree assembled by `npm run cdn:stage`, deployed by the release workflow
cdn-release/

# Environment / secrets (FIGMA_TOKEN etc.)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# NOT ignored on purpose (committed so changes are reviewable in PRs):
#   packages/tokens/figma/export.json      Figma variables, machine-written
#   packages/tokens/upstream/*.json        Web Awesome snapshot
#   packages/theme/src/{tokens,light,dark,webawesome}.css   generated theme CSS

# Generated from the installed Web Awesome manifest by apps/storybook/scripts/wa-api.mjs
apps/storybook/src/wa-api.json

