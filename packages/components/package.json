{
  "name": "@soar-awesome/components",
  "version": "0.1.0",
  "description": "Soar molecules and organisms, composed from Web Awesome. Framework-agnostic custom elements.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ax-field.js": {
      "types": "./dist/molecules/ax-field/ax-field.d.ts",
      "import": "./dist/molecules/ax-field/ax-field.js"
    },
    "./ax-control-info.js": {
      "types": "./dist/molecules/ax-control-info/ax-control-info.d.ts",
      "import": "./dist/molecules/ax-control-info/ax-control-info.js"
    },
    "./ax-data-table.js": {
      "types": "./dist/organisms/ax-data-table/ax-data-table.d.ts",
      "import": "./dist/organisms/ax-data-table/ax-data-table.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.json && cem analyze",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.1"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": "~3.14.0",
    "@soar-awesome/theme": "^0.1.0"
  },
  "devDependencies": {
    "@soar-awesome/theme": "*",
    "@awesome.me/webawesome": "3.14.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
